					{"do": "walk_to", "target": "open", "near": 1},
					{"do": "look_at", "at": "ahead", "ticks": 10},
					{"do": "use_item", "item": "minecraft:spyglass", "ticks": 100},
					{"do": "look_around"},
					{"do": "use_item", "item": "minecraft:spyglass", "ticks": 60},
					{"do": "say", "lines": ["can see for miles", "ooh whats that over there", "spyglass goes hard", "i spy"], "chance": 0.3}
				],
				"make": {"minecraft:spyglass": "minecraft:spyglass"}
			},
			"needs": [{"item": "minecraft:spyglass"}],
			"archetypes": {"nomad": 2.0, "builder": 1.3, "speedrunner": 0.5}, "traits": {"curiosity": 0.6}, "cooldown": 24000, "offscreen": "show",
			"thought": "looking through its spyglass"
		},
