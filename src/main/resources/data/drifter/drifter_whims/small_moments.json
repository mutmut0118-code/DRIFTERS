{
	"whims": [
		{
			"id": "check_the_compass", "category": "micro", "action": "steps",
			"params": {
				"steps": [
					{"do": "hold", "item": "minecraft:compass"},
					{"do": "look_at", "at": "down", "ticks": 40},
					{"do": "look_around"},
					{"do": "think", "text": "checked its compass and got its bearings"}
				]
			},
			"needs": [{"item": "minecraft:compass"}],
			"archetypes": {"nomad": 2.0, "newbie": 1.3}, "traits": {"caution": 0.3}, "cooldown": 24000, "offscreen": "show",
			"thought": "checking its compass"
		},
		{
			"id": "check_the_clock", "category": "micro", "action": "steps", "when": "sunset",
			"params": {
				"steps": [
					{"do": "hold", "item": "minecraft:clock"},
					{"do": "look_at", "at": "down", "ticks": 40},
					{"do": "look_at", "at": "sun", "ticks": 30},
					{"do": "say", "lines": ["getting late", "almost night", "time to head in soon", "sun's going down"], "chance": 0.3}
				]
			},
			"needs": [{"item": "minecraft:clock"}],
			"archetypes": {"homebody": 1.5, "miner": 1.5}, "traits": {"caution": 0.4}, "cooldown": 24000, "offscreen": "show",
			"thought": "checking its clock"
		},
		{
			"id": "look_through_the_spyglass", "category": "micro", "action": "steps", "when": "day",
			"comment": "use_item: the spyglass held up to its eye (the real pose).",
			"params": {
				"find": {"open": {"type": "sky", "radius": 12}},
