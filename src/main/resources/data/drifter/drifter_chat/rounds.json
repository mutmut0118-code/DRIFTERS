{
  "comment": "Chat phase 3: the morning gm round and the bedtime gn round (Drifters who know a player, a few of them one after another), what a Drifter standing by adds when one answers a player (chime.<intent>), and the running jokes' words: what happened (joke.what.<damage type>) and the nickname it earns (joke.nick.<damage type>).",
  "lines": {
    "round.gm": {
      "any": ["gm", "gm {player}", "morning", "mornin", "gm o/", "good morning", "gm gm", "morning {player}", "o/ gm"],
      "newbie": ["good morning!!", "gm {player}!!"],
      "hermit": ["mm. morning", "gm."],
      "homebody": ["morning! sleep well?", "gm {player} :)"],
      "builder": ["gm, big build day today", "morning o/"],
      "pvp_sweat": ["gm", "morning. 1v1 later?"],
      "helper": ["good morning {player}!", "gm! need anything today?"]
    },
    "round.gn": {
      "any": ["gn", "gn {player}", "night", "sleep well", "gn o/", "nn", "gnight"],
      "newbie": ["gn {player}!!", "good night!!"],
      "hermit": ["gn.", "finally, quiet"],
      "homebody": ["sleep tight {player}", "gn :)"],
      "helper": ["sleep well {player}!", "gn, i'll keep watch"]
    },
    "chime.joke": {
      "any": ["lmao", "old one", "bruh", "lol", "boo", "lmaooo", "i'm stealing that", "terrible. 10/10"]
    },
    "chime.insult": {
      "any": ["oof", "ratio", "rude", "dang", "ooooh", "chill"],
      "helper": ["be nice"],
      "pvp_sweat": ["lmao", "ratio"]
    },
    "chime.compliment": {
      "any": ["true", "fr", "facts", "real", "W"]
    },
    "chime.duel": {
      "any": ["ooh fight", "get him {name}", "fight fight fight", "my money's on {name}", "popcorn time", "this'll be good"]
    },
    "chime.give": {
      "any": ["me too pls", "can i have some too?", "generous", "share with me next"]
    },
    "chime.team": {
      "any": ["can i come too?", "trio?", "dont leave me out", "W"]
    },
    "chime.help": {
      "any": ["coming too!", "hold on!", "omw too"]
    },
    "chime.bot": {
      "any": ["we're all bots lol", "beep boop", "aren't we all", "sus"]
    },
